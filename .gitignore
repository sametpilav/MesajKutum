# See http://help.github.com/ignore-files/ for more about ignoring files.

# Dependencies
/node_modules/
/.pnp/
.pnp.js

# Production & Build Outputs
/dist/
/out-tsc/
/bazel-out/

# Angular cache & temporary files
/.angular/cache/
.angular/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Testing & Coverage
/coverage/
/karma_html/
/test-reports/

# IDE and Editor files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Environment and Secret files
.env
.env.*
!.env.example

# Package tarballs
*.tgz
